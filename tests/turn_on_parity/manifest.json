  "product_base_commit": "0f929d1",
  "capture": {
    "directory": "a new directory outside any git repository for every case; paths in a case are relative to it",
    "environment": {
      "HOME": "a new, empty directory",
      "PATH": "the capturing machine's PATH",
      "named per case": "INSTRUMENT_RUN_ENDPOINT_FILE and INSTRUMENT_RUN_ARM for a print case, nothing for a write or remove case"
    },
    "arm": "fixed",
    "writer": "dev's apply_telemetry_env.py run as a script with the case's argv",
    "library": "dev's instrument_run.sh sourced, then `instrument_run` called with the case's labels as key=value",
    "python": "3.14.7"
  },
